<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restaurant - Toma de pedidos"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- PASTEL DE CHOCLO -->
    <TextView
        android:id="@+id/txtChoclo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pastel de Choclo ($15)"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"/>

    <EditText
        android:id="@+id/edtCantidadChoclo"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Cantidad"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/txtChoclo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtSubtotalChoclo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subtotal Choclo: $0"
        app:layout_constraintTop_toBottomOf="@id/edtCantidadChoclo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"/>

    <!-- CAZUELA -->
    <TextView
        android:id="@+id/txtCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cazuela ($10)"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txtSubtotalChoclo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"/>

    <EditText
        android:id="@+id/edtCantidadCazuela"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Cantidad"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/txtCazuela"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtSubtotalCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subtotal Cazuela: $0"
        app:layout_constraintTop_toBottomOf="@id/edtCantidadCazuela"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"/>

    <!-- SWITCH PROPINA -->
    <Switch
        android:id="@+id/switchPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incluir propina (10%)"
        app:layout_constraintTop_toBottomOf="@id/txtSubtotalCazuela"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"/>

    <!-- TOTALES -->
    <TextView
        android:id="@+id/txtTotalSinPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total sin propina: $0"
        app:layout_constraintTop_toBottomOf="@id/switchPropina"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"/>

    <TextView
        android:id="@+id/txtMontoPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Propina: $0"
        app:layout_constraintTop_toBottomOf="@id/txtTotalSinPropina"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"/>

    <TextView
        android:id="@+id/txtTotalFinal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total final: $0"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txtMontoPropina"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
